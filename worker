// Entry point
// ---------------------------------------------------------------------------

export default {
  async fetch(request, env) {
    const origin = request.headers.get("Origin") || "";
    const corsHeaders = getCorsHeaders(origin);
    if (request.method === "OPTIONS") return new Response(null, { status: 204, headers: corsHeaders });

    try {
      const url = new URL(request.url);
      if (url.pathname === "/upload" && request.method === "POST") return await handleUpload(request, env, url, origin, corsHeaders);
      if (url.pathname === "/delete" && request.method === "POST") return await handleDelete(request, env, origin, corsHeaders);
      if (url.pathname.startsWith("/media/") && (request.method === "GET" || request.method === "HEAD")) return await handleMedia(request, env, url, corsHeaders);
      if (url.pathname === "/usage" && request.method === "GET") return await handleUsage(request, env, url, origin, corsHeaders);
      if (url.pathname === "/admin/recount" && request.method === "POST") return await handleRecount(request, env, origin, corsHeaders);
      if (url.pathname === "/" && request.method === "GET") {
        return json({
          service: "Afrishine Hub Media", status: "online",
          capacity: "10 GB", uploadAllowance: "9.5 GB per cycle (starts on the 6th, Africa/Kigali)", maxFile: "100 MB", maxVideo: "5 minutes", dailyVideos: 1,
          upload: "POST /upload", delete: "POST /delete with JSON { key }",
          media: "GET /media/{file-key}", usage: "GET /usage"
        }, 200, corsHeaders);
      }
      return fail("NOT_FOUND", "Not found.", 404, corsHeaders);
    } catch (error) {
      if (error && typeof error === "object" && error.status && error.message) {
        return fail(error.code || "ERROR", error.message, error.status, corsHeaders);
      }
      console.error("Afrishine Media Worker error:", error);
      return fail("SERVER_ERROR", "Request failed. Please try again.", 500, corsHeaders);
    }
  }
};
