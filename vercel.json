{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/",
      "destination": "https://afrishinegithubio.vercel.app/?mode=academy"
    },
    {
      "source": "/:path*",
      "destination": "https://afrishinegithubio.vercel.app/:path*"
    }
  ]
}
